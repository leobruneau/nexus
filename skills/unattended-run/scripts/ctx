#!/usr/bin/env bash
# Delegate to the installed dual-harness ctx CLI tool.
set -euo pipefail

bin_cand="${NEXUS_BIN_DIR:-$HOME/.local/bin}/ctx"
if [[ -x "$bin_cand" ]]; then
  exec "$bin_cand" "$@"
fi
if cmd="$(command -v ctx 2>/dev/null)"; then
  exec "$cmd" "$@"
fi
echo "ctx: not installed; run nexus install.sh" >&2
exit 1
